{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "灵栈",
  "version": "0.12.0",
  "identifier": "app.lingzhan.agent-skill-hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "灵栈 · Agent & Skill 管理器",
        "width": 1380,
        "height": 900,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#f3f5f0"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "本地 Agent 与 Skill 管理器",
    "longDescription": "统一查看、追踪、导出本机与项目中的 Agent 和 Skill。"
  }
}
